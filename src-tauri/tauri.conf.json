{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NIMVORO",
  "version": "1.1.0",
  "identifier": "com.grigoryykach.nimvoro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NIMVORO",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NIMVORO",
    "shortDescription": "Launcher for the NIMVORO utility suite",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian", "Ukrainian"],
        "displayLanguageSelector": false
      }
    }
  }
}
